# TMDB (The Movie Database) credentials, used to load Avengers: Doomsday images for the finale.
# Get them at https://www.themoviedb.org/settings/api. Set ONE of the two.
VITE_TMDB_TOKEN=
VITE_TMDB_API_KEY=

# Optional: skip the search and use this TMDB movie id directly.
VITE_TMDB_MOVIE_ID=

# Optional: extra image URLs for the finale slideshow, comma-separated (they play before the TMDB images).
# Remote images must allow cross-origin use (CORS) to be drawn on the 3D screen.
VITE_PROMO_IMAGES=
